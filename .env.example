# Copy to .env and fill in the workstation values. Never commit .env.

# --- AutoCount SQL Server (used only to build the SDK DBSetting) ---
AUTOCOUNT_SQL_SERVER=
AUTOCOUNT_SQL_USER=
AUTOCOUNT_SQL_PASSWORD=
AUTOCOUNT_DEFAULT_DATABASE=AED_SENG

# Optional direct-SQL reader (fast list/detail reads). Leave disabled to force
# every read through the AutoCount SDK bridge.
AUTOCOUNT_SQL_DIRECT_ENABLED=
AUTOCOUNT_SQL_DIRECT_SERVER=
AUTOCOUNT_SQL_DIRECT_PORT=

# --- AutoCount application login used by the PowerShell SDK bridge ---
AUTOCOUNT_APP_USER=
AUTOCOUNT_APP_PASSWORD=

# Legacy aliases, still read by config.py
AUTOCOUNT_USER=
AUTOCOUNT_PASSWORD=

# --- Companies shown in the switcher: DB:Label, comma separated ---
# Defaults to AED_SENG and AED_MANSON when empty.
AUTOCOUNT_COMPANIES=

# --- Timeouts and caching (seconds) ---
AUTOCOUNT_PROXY_TIMEOUT=120
AUTOCOUNT_SESSION_TTL_SECONDS=43200
AUTOCOUNT_LIST_CACHE_TTL_SECONDS=
AUTOCOUNT_DETAIL_CACHE_TTL_SECONDS=

# --- Flask ---
SENGCHONG_SECRET_KEY=
PORT=5000
